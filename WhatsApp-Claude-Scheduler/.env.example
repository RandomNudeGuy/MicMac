# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenWA settings (leave defaults if running via docker-compose in this folder)
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=your-openwa-master-key
OPENWA_SESSION_ID=default

# Webhook HMAC secret — set the same value in OpenWA's WEBHOOK_SECRET env var
WEBHOOK_SECRET=change-me-to-a-random-string

# Port this server listens on
PORT=3000
